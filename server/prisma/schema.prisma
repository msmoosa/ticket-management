generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(agent)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  deletedAt DateTime?

  // Not Better Auth fields: re-add these back-relations if `auth:generate` drops them.
  assignedTickets Ticket[]
  ticketReplies   TicketReply[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TicketStatus {
  open
  resolved
  closed
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
}

model Ticket {
  id        String          @id @default(cuid())
  subject   String
  // Plain text (HTML-only emails are converted on intake).
  body      String
  // Lowercased sender address.
  fromEmail String
  fromName  String?
  // RFC 5322 Message-ID: dedupes provider retries and enables reply threading later.
  messageId String?         @unique
  status    TicketStatus    @default(open)
  // Null until the ticket is classified (by AI in Phase 5, or by an agent).
  category  TicketCategory?
  // The agent (or admin) working the ticket; null while unassigned.
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  replies   TicketReply[]
  // When the sender started waiting for an answer: their earliest message since the last agent
  // reply (the ticket's creation, or a customer reply). Null once an agent has replied.
  awaitingReplySince DateTime? @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@index([assignedToId])
  @@map("ticket")
}

enum TicketReplySender {
  // Written by an agent (or admin) on the detail page.
  agent
  // Emailed by the ticket's sender in reply to the thread (inbound webhook).
  customer
}

// A message in a ticket's reply thread (oldest first), after the original email in `Ticket.body`.
// Agent replies are not emailed to the sender yet: outbound email is planned (Phase 6).
model TicketReply {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    TicketReplySender @default(agent)
  // Plain text. Customer replies have the quoted earlier conversation stripped.
  body      String
  // The agent who wrote it; always null for customer replies (the sender is the ticket's
  // `fromEmail`). Users are soft-deleted, so an agent's id survives; null after a hard delete.
  authorId  String?
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // RFC 5322 Message-ID of an emailed reply: dedupes provider retries and lets later replies
  // that reference it thread onto the same ticket.
  messageId String?           @unique
  createdAt DateTime          @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_reply")
}
