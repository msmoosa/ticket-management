# Test env: loaded automatically by `bun test` (NODE_ENV=test) and by the e2e servers.
# Copy to .env.test. The database name MUST end in `_test` — `db:test:reset` wipes it.
PORT=3100
DATABASE_URL="postgresql://USER@localhost:5432/helpdesk_test"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
CLIENT_ORIGIN=http://localhost:5174
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
