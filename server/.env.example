PORT=3000
DATABASE_URL="postgresql://USER@localhost:5432/helpdesk"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173
# Admin user created by `bun run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
# Inbound email webhook (POST /api/webhooks/inbound-email): only mail sent to SUPPORT_EMAIL
# becomes a ticket, and callers must send INBOUND_EMAIL_SECRET in the X-Webhook-Secret header.
SUPPORT_EMAIL=support@example.com
# Generate with: openssl rand -base64 32
INBOUND_EMAIL_SECRET=

# Production only (set by the Dockerfile / Railway; see "Deployment" in README.md)
# Serve the built client from this directory on the API's origin.
# CLIENT_DIST_DIR=../client/dist
# Header the reverse proxy puts the client's IP in, for per-IP sign-in rate limiting (Railway: x-real-ip).
# CLIENT_IP_HEADER=x-real-ip
